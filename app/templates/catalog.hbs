{{page-title "Catalog"}}

<div class="container mx-auto lg:max-w-(--breakpoint-lg) pt-6 md:pt-10 pb-10 md:pb-48 px-3 md:px-6">
  <div class="border-b border-gray-200 dark:border-white/5 pb-2 mb-6">
    <h1 class="text-3xl leading-9 text-gradient-to-b from-gray-950 to-gray-700 dark:from-white dark:to-gray-300 font-bold tracking-tighter">
      Challenges
    </h1>
  </div>

  <CatalogPage::ProfilePrompt @featureSuggestion={{this.onboardingProfileFeatureSuggestion}} @onboardingSurvey={{this.model.onboardingSurvey}}>
    {{#if this.authenticator.currentUser.pendingProductWalkthroughFeatureSuggestion}}
      <ProductWalkthroughFeatureSuggestion
        @featureSuggestion={{this.authenticator.currentUser.pendingProductWalkthroughFeatureSuggestion}}
        class="mb-6"
      />
    {{else if (not this.authenticator.isAuthenticated)}}
      <ProductWalkthroughFeatureSuggestion class="mb-6" />
    {{else if this.shouldShowUserAudioSurveyBanner}}
      <AlertWithIcon
        @type="info"
        @icon="microphone"
        @isDismissable={{true}}
        @onDismiss={{this.dismissAudioSurveyBanner}}
        class="mb-6"
        data-test-user-audio-survey-banner
      >
        <p>
          <button type="button" {{on "click" this.createAudioSurveyInvite}} data-test-user-audio-survey-banner-button>
            Help us improve CodeCrafters by taking a short audio survey
          </button>
        </p>
      </AlertWithIcon>
    {{/if}}
  </CatalogPage::ProfilePrompt>

  <CatalogPage::Personalization @course={{this.recommendedCourse}} />
  {{#if this.recommendedCourse}}
    <div class="flex justify-between items-center gap-4 mb-4 mt-6"><h2 class="text-base font-semibold text-gray-900 dark:text-gray-200">{{if
          this.usePersonalizedOrder
          "All challenges, ordered for you"
          "All challenges"
        }}</h2><button
        type="button"
        class="text-xs text-teal-700 dark:text-teal-400 underline"
        {{on "click" this.togglePersonalizedOrder}}
        data-test-toggle-catalog-order
      >{{if this.usePersonalizedOrder "Use default order" "Use personalized order"}}</button></div>
  {{/if}}
  <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-2 mb-8">
    {{#each this.orderedCourses as |course|}}
      <CourseCard @course={{course}} />
    {{/each}}
  </div>

  <div class="border-b border-gray-200 dark:border-white/5 pb-2 mb-6">
    <h2 class="text-3xl leading-9 text-gradient-to-b from-gray-950 to-gray-700 dark:from-white dark:to-gray-300 font-bold tracking-tighter">
      Language Tracks
    </h2>
  </div>

  <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3 mb-8">
    {{#each this.orderedLanguages as |language|}}
      {{! @glint-expect-error: not ts-ified yet }}
      <TracksPage::TrackCard @language={{language}} />
    {{/each}}
  </div>
</div>