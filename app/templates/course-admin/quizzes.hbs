{{page-title "Quizzes"}}

<div class="bg-white min-h-screen">
  <div class="container mx-auto pt-4 pb-10 px-6">
    <div class="pt-3 pb-6 border-b border-gray-200 flex items-start justify-between">
      <div>
        <h3 class="text-lg font-bold text-gray-900 mb-1">
          Competition Quizzes
        </h3>
        <div class="text-xs text-gray-400">
          Quizzes participants submitted for partner competitions. The AI read is evidence for you to check, not a verdict.
        </div>
      </div>
      <div class="flex flex-col items-end">
        <Toggle @isOn={{this.shouldShowUndecidedOnly}} data-test-undecided-only-toggle {{on "click" this.handleUndecidedOnlyToggle}} />

        <div class="text-xs text-gray-400 mt-2">
          {{if this.shouldShowUndecidedOnly "Show undecided only" "Show all"}}
        </div>
      </div>
    </div>

    <ul role="list" class="divide-y divide-gray-100">
      {{#each this.visibleQuizzes key="id" as |quiz|}}
        <CourseAdmin::QuizzesPage::QuizListItem @course={{this.model.course}} @quiz={{quiz}} />
      {{else}}
        <div class="text-gray-400 py-32 flex items-center justify-center">
          No quizzes found.
        </div>
      {{/each}}
    </ul>
  </div>
</div>