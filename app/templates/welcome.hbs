{{page-title "Welcome"}}

<div {{did-insert this.handleDidInsertContainer}}>
  <WelcomePage::OnboardingSurveyWizard
    @onboardingSurvey={{@model.onboardingSurvey}}
    @courses={{@model.courses}}
    @hasNextDestination={{not (not (or this.next this.stashedNext))}}
    @onSurveyComplete={{this.handleSurveyCompleted}}
  />
</div>