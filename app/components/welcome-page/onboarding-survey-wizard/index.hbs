<div class="onboarding-workspace" data-test-onboarding-survey-wizard>
  <aside class="sidebar" aria-label="Your onboarding journey">
    <LinkTo @route="catalog" class="brand"><img src={{this.wordmarkUrl}} alt="CodeCrafters home" width="206" height="27" /></LinkTo>
    <div class="sidebar-story">
      <p class="welcome-note">For the curious developer.</p>
      <h2>Build the tools.<br />Understand<br />the internals.</h2>
      <p class="sidebar-description">Real systems, built from scratch.<br />One small stage at a time.</p>
    </div>
    {{#if this.recommendedCourse}}
      <div class="sidebar-preview" aria-live="polite" aria-atomic="true" data-test-live-preview>
        <p>A preview of what comes next</p>
        <CourseLogo @course={{this.recommendedCourse}} />
        <h3>{{this.recommendedCourse.name}}</h3>
        <p>{{this.recommendationReason}}</p>
        <small>Every challenge stays open to you.</small>
      </div>
    {{/if}}
    <p class="sidebar-footer">Your editor. Your language. Your code.</p>
  </aside>

  <section class="main-panel" aria-label="Get started with CodeCrafters" aria-busy={{this.isSaving}}>
    <header class="topbar"><span>Welcome to CodeCrafters</span><span
        class="progress-text"
        aria-live="polite"
        data-test-step-progress
      >{{this.currentStep}} of 2</span></header>
    <div class="mobile-progress" aria-hidden="true"><span data-step={{this.currentStep}}></span></div>
    <form {{on "submit" this.continue}} aria-busy={{this.isSaving}}>
      {{#if this.saveError}}<p class="save-error" role="alert" data-test-save-error>{{this.saveError}}</p>{{/if}}

      {{#if (eq this.currentStep 1)}}
        <section class="step" aria-labelledby="onboarding-goal-heading">
          <div class="step-intro">
            <p class="section-context">Let curiosity lead.</p>
            <h1 id="onboarding-goal-heading" tabindex="-1" {{did-insert this.focusHeading}}>What brings you here?</h1>
            <p class="step-description">Choose your main goal. We'll use it to help shape your starting point.</p>
          </div>
          <fieldset disabled={{this.isSaving}}>
            <legend class="sr-only">Your main goal</legend>
            <div class="goal-grid">
              {{#each this.goals as |goal|}}
                <label class="goal-choice" data-test-goal={{goal.value}}>
                  <input
                    type="radio"
                    name="onboarding-goal"
                    value={{goal.value}}
                    checked={{eq this.goal goal.value}}
                    {{on "change" this.selectGoal}}
                  />
                  <span class="choice-icon" aria-hidden="true">{{svg-jar goal.icon class="" role="presentation"}}</span>
                  <strong>{{goal.title}}</strong><span class="choice-description">{{goal.description}}</span>
                  <span class="choice-indicator" aria-hidden="true">{{svg-jar "check-outline" class="" role="presentation"}}</span>
                </label>
              {{/each}}
            </div>
            <label class="other-goal" data-test-goal="other"><input
                type="radio"
                name="onboarding-goal"
                value="other"
                checked={{eq this.goal "other"}}
                {{on "change" this.selectGoal}}
              /><span>Something else</span></label>
            {{#if (eq this.goal "other")}}
              <label class="other-answer">What would you like to work on?
                <textarea
                  value={{@onboardingSurvey.freeFormAnswerForUsagePurpose}}
                  rows="2"
                  maxlength="500"
                  placeholder="Tell us in your own words"
                  {{on "input" this.updateGoalText}}
                  data-test-goal-text
                ></textarea>
              </label>
            {{/if}}
          </fieldset>
          <footer class="step-actions">
            <button class="button button-quiet" type="button" disabled={{this.isSaving}} {{on "click" this.skipGoal}} data-test-skip-goal>Skip this
              question</button>
            <button class="button button-primary" type="submit" disabled={{this.isSaving}} data-test-continue-button>
              {{if this.isSaving "Saving..." "Continue"}}{{svg-jar "arrow-right-outline" class="" role="presentation"}}
            </button>
          </footer>
        </section>
      {{else if (eq this.currentStep 2)}}
        <section class="step" aria-labelledby="onboarding-about-heading">
          <div class="step-intro">
            <p class="section-context">Optional preferences</p>
            <h1 id="onboarding-about-heading" tabindex="-1" {{did-insert this.focusHeading}}>Personalize your challenges</h1>
            <p class="step-description">A few quick choices help us put relevant builds first. Answer what you like. You can explore everything.</p>
          </div>
          <fieldset class="question-group" disabled={{this.isSaving}}>
            <legend>What do you work on?</legend><p class="field-hint">We'll bring related challenges to the front.</p>
            <div class="role-grid">
              {{#each this.roles as |role|}}
                <label class="pill-choice" data-test-role={{role}}><input
                    type="radio"
                    name="onboarding-role"
                    value={{role}}
                    checked={{eq this.role role}}
                    {{on "change" this.selectRole}}
                  /><span>{{role}}</span></label>
              {{/each}}
            </div>
            {{#if this.role}}<button
                class="button button-quiet clear-preference"
                type="button"
                {{on "click" (fn this.clearField "role")}}
                data-test-clear-role
              >Clear role</button>{{/if}}
            {{#if (eq this.role "Other")}}<label class="other-answer">Your role (optional)<input
                  type="text"
                  value={{this.otherRole}}
                  maxlength="100"
                  placeholder="e.g. DevOps engineer"
                  {{on "input" this.updateOtherRole}}
                  data-test-other-role
                /></label>{{/if}}
          </fieldset>
          <fieldset class="question-group experience-group" disabled={{this.isSaving}}>
            <legend>How long have you programmed professionally?</legend>
            <div class="experience-grid">
              {{#each this.experienceRanges as |range|}}
                <label class="experience-choice" data-test-experience={{range}}><input
                    type="radio"
                    name="onboarding-experience"
                    value={{range}}
                    checked={{eq this.experience range}}
                    {{on "change" this.selectExperience}}
                  /><strong>{{range}}</strong><span>years</span></label>
              {{/each}}
            </div>
            {{#if this.experience}}<button
                class="button button-quiet clear-preference"
                type="button"
                {{on "click" (fn this.clearField "experience")}}
                data-test-clear-experience
              >Clear experience</button>{{/if}}
            <p class="field-hint">We'll tailor your starting guidance. Less than 2 includes no professional experience.</p>
          </fieldset>
          <fieldset class="question-group company-group" disabled={{this.isSaving}}>
            <legend>How big is your company?</legend>
            <p class="field-hint">This helps us understand the teams using CodeCrafters.</p>
            <div class="role-grid">
              {{#each this.companySizes as |size|}}
                <label class="pill-choice" data-test-company-size={{size}}><input
                    type="radio"
                    name="onboarding-company"
                    value={{size}}
                    checked={{eq this.companySize size}}
                    {{on "change" this.selectCompanySize}}
                  /><span>{{size}}</span></label>
              {{/each}}
            </div>
            {{#if this.companySize}}<button
                class="button button-quiet clear-preference"
                type="button"
                {{on "click" (fn this.clearField "companySize")}}
                data-test-clear-company
              >Clear company size</button>{{/if}}
          </fieldset>
          <footer class="step-actions about-actions">
            <button class="button button-back" type="button" disabled={{this.isSaving}} {{on "click" this.back}} data-test-back>{{svg-jar
                "arrow-left-outline"
                class=""
                role="presentation"
              }}Back</button>
            <div class="action-group"><button
                class="button button-quiet"
                type="button"
                {{on "click" this.skipProfile}}
                disabled={{this.isSaving}}
                data-test-skip-profile
              >I'll pick myself</button><button class="button button-primary" type="submit" disabled={{this.isSaving}} data-test-continue-button>{{if
                  this.isSaving
                  "Saving..."
                  (if @hasNextDestination "Continue where you left off" "Show my challenges")
                }}{{svg-jar "arrow-right-outline" class="" role="presentation"}}</button></div>
          </footer>
        </section>
      {{/if}}
    </form>
  </section>
</div>