<div class="overflow-y-auto" data-test-report ...attributes>
  <div class="mx-auto max-w-3xl px-1 py-4 md:py-8">
    <div class="flex flex-wrap items-center gap-3 mb-2">
      <h1 class="text-2xl font-semibold text-gray-50">Interview feedback</h1>
      <Pill @color={{this.overallVerdictColor}} data-test-overall-verdict>{{this.overallVerdictLabel}}</Pill>
    </div>

    <div class="text-sm text-gray-500 mb-4">
      {{@repository.course.name}}
      ·
      {{@milestone.title}}
      ·
      <span data-test-questions-demonstrated>
        {{this.demonstratedQuestionsCount}}
        of
        {{this.plannedQuestionsCount}}
        questions demonstrated
      </span>
    </div>

    <p class="text-gray-300 leading-relaxed mb-8" data-test-report-summary>{{@report.summary}}</p>

    <div class="space-y-4 mb-8">
      {{#each @report.questions as |question index|}}
        <div class="rounded-lg border border-white/10 bg-gray-900/60 p-5" data-test-report-question>
          <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
            <div class="flex items-start min-w-0">
              <span class="mr-3 mt-0.5 flex w-6 h-6 shrink-0 items-center justify-center rounded-full bg-gray-800 text-xs text-gray-400">
                {{add index 1}}
              </span>
              <h2 class="font-medium text-gray-100 leading-snug" data-test-question-text>{{question.question}}</h2>
            </div>

            <Pill @color={{this.verdictColor question.verdict}} @size="small" class="shrink-0" data-test-question-verdict>
              {{this.verdictLabel question.verdict}}
            </Pill>
          </div>

          <p class="text-sm text-gray-400 leading-relaxed mb-4">{{question.verdict_explanation}}</p>

          {{#if question.evidence_quote}}
            <div class="mb-4">
              <div class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5">What you said</div>
              <blockquote class="border-l-2 border-gray-700 pl-3 text-sm italic text-gray-300" data-test-evidence-quote>
                "{{question.evidence_quote}}"
              </blockquote>
            </div>
          {{/if}}

          {{#if question.strong_answer_points.length}}
            <div class="mb-4">
              <div class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5">A strong answer covers</div>
              <ul class="list-disc pl-5 space-y-1 text-sm text-gray-300">
                {{#each question.strong_answer_points as |point|}}
                  <li>{{point}}</li>
                {{/each}}
              </ul>
            </div>
          {{/if}}

          {{#if question.anchor}}
            <CourseInterviewPage::CodeExcerpt @anchor={{question.anchor}} @codeFiles={{@codeFiles}} />
          {{/if}}
        </div>
      {{/each}}
    </div>

    {{#if @report.review_suggestions.length}}
      <div class="rounded-lg border border-teal-500/20 bg-teal-950/30 p-5 mb-8" data-test-review-suggestions>
        <div class="flex items-center text-sm font-semibold text-teal-300 mb-2">
          {{svg-jar "light-bulb" class="w-4 h-4 mr-2"}}
          What to review next
        </div>
        <ul class="list-disc pl-5 space-y-1 text-sm text-gray-300">
          {{#each @report.review_suggestions as |suggestion|}}
            <li>{{suggestion}}</li>
          {{/each}}
        </ul>
      </div>
    {{/if}}

    <div class="flex flex-wrap items-center gap-3">
      <PrimaryLinkButton @route="course" @model={{@repository.course.slug}} @query={{hash repo=@repository.id}} data-test-back-to-challenge-button>
        Back to challenge
      </PrimaryLinkButton>

      <TertiaryButton data-test-retake-button {{on "click" @onRetakeButtonClick}}>
        Retake interview
      </TertiaryButton>
    </div>
  </div>
</div>