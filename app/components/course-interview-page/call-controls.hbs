<div class="flex items-center justify-center" data-test-call-controls ...attributes>
  <div class="flex items-center gap-2 rounded-lg border border-white/10 bg-gray-900 p-1.5">
    <button
      type="button"
      class="flex items-center gap-2 rounded-md px-3 py-2 text-sm transition-colors
        {{if this.voiceInterview.isMuted 'bg-red-900/60 text-red-200 hover:bg-red-900' 'text-gray-200 hover:bg-gray-800'}}"
      aria-pressed={{if this.voiceInterview.isMuted "true" "false"}}
      data-test-mute-button
      {{on "click" this.handleMuteButtonClick}}
    >
      {{svg-jar "microphone" class="w-4 h-4"}}
      {{if this.voiceInterview.isMuted "Unmute" "Mute"}}
    </button>

    <button
      type="button"
      class="flex items-center gap-2 rounded-md px-3 py-2 text-sm text-gray-200 transition-colors hover:bg-gray-800"
      aria-pressed={{if @shouldShowCaptions "true" "false"}}
      data-test-captions-toggle-button
      {{on "click" @onCaptionsToggle}}
    >
      {{svg-jar (if @shouldShowCaptions "eye-off" "eye") class="w-4 h-4"}}
      {{if @shouldShowCaptions "Hide captions" "Show captions"}}
    </button>
  </div>
</div>