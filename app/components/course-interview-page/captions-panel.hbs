<div class="relative overflow-hidden" aria-live="polite" data-test-captions-panel ...attributes>
  {{#animated-if @isVisible use=this.fade duration=250}}
    <div class="flex flex-col justify-end h-full px-1">
      {{#if this.previousLine}}
        <p
          class="text-sm leading-relaxed mb-4 line-clamp-3 {{if (eq this.previousLine.role 'user') 'text-gray-600 italic' 'text-gray-500'}}"
          data-test-previous-caption
        >
          {{this.previousLine.visibleText}}
        </p>
      {{/if}}

      {{#each this.latestLines key="id" as |line|}}
        <div
          class="flex items-center mb-1.5 text-xs font-semibold uppercase tracking-wide {{if (eq line.role 'agent') 'text-teal-400' 'text-gray-500'}}"
        >
          {{if (eq line.role "agent") "Interviewer" "You"}}
        </div>
        <p class="leading-relaxed {{if (eq line.role 'agent') 'text-gray-50 text-base' 'text-gray-400 text-sm italic'}}" data-test-latest-caption>
          {{~#each this.latestLineWords key="@index" as |word|~}}
            <span class="interview-caption-word">{{word}}</span>
          {{~/each~}}
        </p>
      {{else}}
        {{#if this.voiceInterview.isConnecting}}
          <p class="text-sm text-gray-500" data-test-connecting-caption>Connecting you to the interviewer...</p>
        {{/if}}
      {{/each}}

      {{#if this.shouldShowListeningIndicator}}
        <div class="flex items-center mt-4 text-xs text-gray-400" data-test-listening-indicator>
          <span class="relative flex w-2 h-2 mr-2">
            <span class="absolute inline-flex w-full h-full rounded-full bg-green-400 opacity-75 animate-ping"></span>
            <span class="relative inline-flex w-2 h-2 rounded-full bg-green-500"></span>
          </span>
          I'm listening...
        </div>
      {{/if}}
    </div>
  {{/animated-if}}
</div>